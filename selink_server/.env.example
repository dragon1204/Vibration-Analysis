# Copy to .env and change every secret before deploying.
# (docker env files do not support comments at the end of a line)

# Public domain for automatic HTTPS (e.g. smartmotor.selink.vn) or :80 for plain HTTP
APP_ENV=production
SITE_ADDRESS=:80
PUBLIC_BASE_URL=http://localhost
# CN/SAN of the EMQX TLS certificate (public DNS name of the broker)
MQTT_HOST=localhost

POSTGRES_USER=smartmotor
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=smartmotor

MINIO_ROOT_USER=smartmotor
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=smartmotor

MQTT_INGEST_USER=svc-ingest
MQTT_INGEST_PASS=change-me-mqtt

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@selink.vn
ADMIN_PASSWORD=change-me-admin

# Notifications (leave empty to disable a channel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=smartmotor@selink.vn
TELEGRAM_BOT_TOKEN=
ZALO_OA_TOKEN=
SMS_URL=
SMS_TOKEN=

LOG_LEVEL=INFO

# Host ports (change if already used on this machine)
HTTP_PORT=80
HTTPS_PORT=443
MQTT_TLS_PORT=8883
MQTT_DEV_PORT=1883
# Sensor simulator (normal | demo | warning | danger). The service only starts with
# `docker compose --profile simulation up -d simulator`.
SIM_SCENARIO=demo
SIM_INTERVAL_S=2
SIM_CAPTURE_INTERVAL_S=60
SIM_SEED=153
