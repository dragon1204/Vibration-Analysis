# HTTPS (automatic Let's Encrypt when SITE_ADDRESS is a public domain), reverse proxy, static web.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Internal endpoints (EMQX auth/ACL) are never exposed.
	# (handle blocks are mutually exclusive and evaluated in order, so this must come first)
	handle /api/v1/internal/* {
		respond 404
	}
	# Keep the production API schema private. It remains available inside the API container.
	handle /api/v1/docs* {
		respond 404
	}
	handle /api/v1/openapi.json {
		respond 404
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
