# App
HOST=0.0.0.0
PORT=4000
ENABLE_TLS=false
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem
API_PREFIX=api

# Database
DB_URL=postgres://user:password@host:5432/db

# JWT/Auth
JWT_SECRET_KEY=secret

# yootek-backend
YOOTEK_BACKEND_URL=http://localhost:21021
YOOTEK_DB_URL=postgres://user:password@host:5432/db

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=username
MQTT_PASSWORD=password

# Firebase
FIREBASE_PROJECT_ID=yootek-iot
FIREBASE_PRIVATE_KEY=private_key
FIREBASE_CLIENT_EMAIL=client_email

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
CLOUDINARY_DEFAULT_FOLDER=default_folder

# Redis
REDIS_URL=redis://localhost:6379

#S3
S3_ACCESS_KEY=s3_access_key
S3_SECRET_KEY=s3_secret_key
S3_BUCKET=s3_bucket
S3_REGION=s3_region
S3_BASE_URL=s3_base_url
S3_FOLDER=s3_folder

