<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Login Failed</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f8f8f8;
        }

        .message {
            text-align: center;
            padding: 20px;
            border: 1px solid #ff4d4d;
            border-radius: 5px;
            background-color: #ffe6e6;
            color: #ff4d4d;
        }

        .message h1 {
            margin-top: 0;
        }

        .message p {
            margin-bottom: 0;
        }
    </style>
</head>

<body>
    <div class="message">
        <h1>Login Failed</h1>
        <p>Your username, password, or tenant is incorrect. Please try again.</p>
    </div>
</body>

</html>