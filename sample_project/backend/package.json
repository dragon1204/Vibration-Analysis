{
  "name": "yootek-ioc-onsite",
  "version": "0.0.1",
  "description": "",
  "author": "yootek",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "set NODE_ENV=development && nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:repl": "NODE_ENV=development nest start --entryFile repl --watch",
    "start:prod": "NODE_ENV=production node dist/main",
    "dev": "NODE_ENV=development nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config ./jest-config.json --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:studio": "dotenv -e .env.development -- npx prisma studio --schema src/prisma/schema.prisma",
    "prisma:seed": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register src/prisma/seed.ts",
    "prisma:generate": "dotenv -e .env.development -- npx prisma generate --schema src/prisma/schema.prisma",
    "prisma:db-pull": "dotenv -e .env.development -- npx prisma db pull --schema src/prisma/schema.prisma",
    "prisma:migrate-diff": "dotenv -e .env.development -- npx prisma migrate diff --from-schema-datamodel src/prisma/schema.prisma --to-schema-datasource src/prisma/schema.prisma",
    "prisma:migrate-save": "dotenv -e .env.development -- npx prisma migrate dev --schema src/prisma/schema.prisma --create-only init",
    "prisma:db-push": "dotenv -e .env.development -- npx prisma db push --schema src/prisma/schema.prisma",
    "prisma:db-push:prod": "dotenv -e .env.production -- npx prisma db push --schema src/prisma/schema.prisma",
    "prisma:migrate-up": "dotenv -e .env.development -- npx prisma migrate deploy --schema src/prisma/schema.prisma",
    "prisma:clean": "dotenv -e .env.development -- npx prisma migrate reset --schema src/prisma/schema.prisma",
    "prisma:generate:prod": "dotenv -e .env.production -- npx prisma generate --schema src/prisma/schema.prisma",
    "prisma-yootek:generate": "dotenv -e .env.development -- npx prisma generate --schema src/prisma/yootek-schema.prisma",
    "prisma-yootek:generate:prod": "dotenv -e .env.production -- npx prisma generate --schema src/prisma/yootek-schema.prisma",
    "prisma:generate-all": "npm run prisma:generate",
    "postinstall": "npm run prisma:generate-all && husky install",
    "postuninstall": "npm run prisma:generate-all && husky uninstall"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.592.0",
    "@clickhouse/client": "^1.18.2",
    "@gltf-transform/core": "^4.3.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/cache-manager": "^2.2.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.3",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/platform-socket.io": "^10.3.3",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.1.16",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.3.3",
    "@prisma/client": "^5.18.0",
    "@tuya/tuya-connector-nodejs": "^2.1.2",
    "axios": "^1.6.7",
    "bcrypt": "^6.0.0",
    "bson": "^6.3.0",
    "cache-manager": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.0.3",
    "cron": "^3.1.6",
    "cron-parser": "^4.9.0",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.10",
    "firebase-admin": "^12.0.0",
    "hbs": "^4.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "mqtt": "^5.3.5",
    "nest-winston": "^1.9.4",
    "nestjs-i18n": "^10.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "prisma-json-types-generator": "^3.0.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.6.2",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "5.18.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
